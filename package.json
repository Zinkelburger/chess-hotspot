{
  "name": "chess-hotspot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/build-event-pages.mjs && next build && node scripts/check-seo.mjs",
    "start": "next start",
    "spots:add": "node scripts/add-spot.mjs",
    "spots:import:uscf": "python3 scripts/import_uscf_clubs.py",
    "spots:fill": "python3 scripts/fill_clubs.py",
    "events:scrape:py": "python3 scripts/scrape_events.py",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:scrapers": "python3 -m pytest scripts/tests -q",
    "events:refresh": "bash scripts/refresh_events.sh",
    "learn:coaches": "python3 scripts/scrape_lichess_coaches.py",
    "learn:build": "python3 scripts/build_learn.py",
    "preview": "python3 scripts/serve-preview.py"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "maplibre-gl": "^5.5.0",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250605.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.19.1"
  }
}
